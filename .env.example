APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Set APP_URL to your public tunnel/domain. M-Pesa webhook URLs derive from it.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (PostgreSQL)
# Local development connects to the host database. Docker Compose overrides
# DB_HOST with the "db" service and the remaining DB_* values with POSTGRES_*.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=q_cash
DB_USERNAME=qcash
DB_PASSWORD=

# PostgreSQL container credentials for the Docker Compose "db" service.
# Set a strong POSTGRES_PASSWORD before running `docker compose up`.
POSTGRES_DB=q_cash
POSTGRES_USER=qcash
POSTGRES_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_ENDPOINT=

# Python ML/Decision API base URL (FastAPI docs at /docs)
QCASH_ML_API_URL=http://localhost:3004

# Safaricom Daraja (M-Pesa)
MPESA_ENVIRONMENT=sandbox
# Optional; falls back to the sandbox/production URL for MPESA_ENVIRONMENT.
MPESA_BASE_URL=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# Webhook URLs are derived from APP_URL. Optional overrides:
# MPESA_WEBHOOK_BASE_URL=
# MPESA_CALLBACK_URL=
# MPESA_VALIDATION_URL=
MPESA_VALIDATION_ENABLED=false
# MPESA_STK_CALLBACK_URL=
MPESA_TIMEZONE=Africa/Nairobi
MPESA_B2C_SHORTCODE=174379
# B2C credentials: provide either a pre-encrypted SECURITY_CREDENTIAL
# or the plaintext INITIATOR_PASSWORD plus the Safaricom certificate.
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_INITIATOR_PASSWORD=
# Defaults to storage/app/certificates/mpesa_public_cert.cer
# MPESA_B2C_CERTIFICATE_PATH=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_B2C_COMMAND_ID=BusinessPayment
# MPESA_B2C_RESULT_URL=
# MPESA_B2C_TIMEOUT_URL=
# MPESA_B2C_STATUS_RESULT_URL=
# MPESA_B2C_STATUS_TIMEOUT_URL=
MPESA_B2C_RECONCILE_AFTER_MINUTES=5
MPESA_B2C_RECONCILE_INTERVAL_MINUTES=10
MPESA_B2C_RECONCILE_MAX_ATTEMPTS=6
MPESA_B2C_RECONCILE_REQUEST_DELAY_MS=2000
MPESA_PAYBILL_NUMBER=456456
MPESA_SHORTCODE=174379


# Revenue deduction repayment (amounts are minor units)
REPAYMENT_DAILY_CAP_MINOR=400000
REPAYMENT_WORKING_CAPITAL_FLOOR_BPS=8500

# Africa's Talking USSD
AFRICASTALKING_USSD_SERVICE_CODE=
AFRICASTALKING_USSD_SESSION_TTL_MINUTES=5

# Advance access fee (basis points)
ACCESS_FEE_BPS=200

# Maximum repayment window for new advances (days)
REPAYMENT_MAXIMUM_DAYS=30
